[TEMPLATE]
# ================= SentinelVision AI — environment template =================
# Copy to backend/.env (API/worker) and/or frontend/.env (build-time vars).

# ------------------------- Backend (backend/.env) ---------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_real_secret
ENVIRONMENT=development            # development | demo | production
DEMO_MODE=true                     # labels synthetic data as DEMO in the UI

# SQLite (zero-setup). For PostgreSQL:
#   postgresql+psycopg://sentinel:PASSWORD@localhost:5432/sentinelvision
DATABASE_URL=sqlite:///./sentinelvision.db

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1

# Video / AI tuning
MAX_CONCURRENT_STREAMS=8           # keep small on a laptop
INGEST_FPS_LIMIT=12
DETECTION_SAMPLE_INTERVAL=1.0      # seconds between AI passes per camera
DETECTION_CONFIDENCE=0.35
OCR_MIN_CONFIDENCE=0.55            # below this, plate reads need review
YOLO_WEIGHTS=yolov8n.pt
ENABLE_GPU=false                   # true only with a CUDA torch build
DETECT_PERSONS=true
ANPR_ENABLED=true

# Optional extended AI modules (each fully independent; failures are isolated)
ENABLE_REID=true                   # appearance matches are recorded as UNCONFIRMED
ENABLE_ATTRIBUTES=true             # color/body-style heuristic tier (no deps needed)
ENABLE_PERSON_MODEL=true           # dedicated person model (needs ultralytics)
ENABLE_QUALITY=true                # frame blur/brightness scoring (pure OpenCV)
ENABLE_ANOMALY=true                # movement review events only — never criminal labels
REID_SIMILARITY_THRESHOLD=0.72
REID_MATCH_TTL_MINUTES=120
ANOMALY_SPEED_LIMIT_KMPH=90
ANOMALY_COOLDOWN_SECONDS=300
QUALITY_SAMPLE_EVERY_N=100
ENABLE_WATCHLIST=true             # real-time matching of confirmed ANPR reads against watchlist
WATCHLIST_MATCH_MIN_CONFIDENCE=0.70  # minimum OCR confidence for a watchlist hit
# VEHICLE_ATTRIBUTE_WEIGHTS=       # optional torch embedding checkpoint path

# Alerts / health
HEALTH_CHECK_INTERVAL=60
ALERT_OFFLINE_AFTER=180

# Access tokens
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------- Frontend (frontend/.env) -------------------------
# Leave unset to use the same-origin vite proxy / nginx (recommended).
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_WS_URL=ws://localhost:8000
